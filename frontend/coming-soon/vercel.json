{
  "framework": null,
  "installCommand": "echo 'No install (static coming-soon)'",
  "buildCommand": "echo 'No build (static coming-soon)'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sb-coming-soon.mp4",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Content-Type",
          "value": "video/mp4"
        }
      ]
    }
  ]
}
